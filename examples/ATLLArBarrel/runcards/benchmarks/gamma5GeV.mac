#Benchmark macro (see Results.md), requires -DWITH_GPS=OFF
#/run/setCut must precede /run/initialize (AdePT issue #745)
/run/setCut 0.01 mm
/run/initialize
/run/printProgress 100
/gun/particle gamma
/gun/energy 5 GeV
/gun/position 0. 0. 0. m
#eta 0.2 phi 0.01225 (0.0245/2)
/gun/direction 0.980254 0.0120087 0.197375
/run/beamOn 300
