#Position scan (see README.md), 20 GeV e-, eta 0.212500, phi 0.006136, 1000 events
#AdePT build (-DWITH_ADEPT=ON), requires -DWITH_GPS=OFF
/random/setSeeds 20261123 3007
/adept/setSeed 8007
/adept/setVerbosity 0
/adept/setMillionsOfTrackSlots 1
/adept/setMillionsOfHitSlots 1
/adept/setCUDAStackLimit 8192
/adept/setTrackInAllRegions true
/adept/SetEnergyLossFluctuation true
#/run/setCut must precede /run/initialize (AdePT issue #745)
/run/setCut 0.01 mm
/run/initialize
/run/printProgress 100
/gun/particle e-
/gun/energy 20 GeV
/gun/position 0. 0. 0. m
/gun/direction 0.9778206 0.0059999 0.2093582
/run/beamOn 1000
