#Position scan (see README.md), 20 GeV e-, eta 0.209375, phi 0.012250, 1000 events
#CPU builds (FTFP_BERT and matched), requires -DWITH_GPS=OFF
/random/setSeeds 20261123 3003
#/run/setCut must precede /run/initialize (AdePT issue #745)
/run/setCut 0.01 mm
/run/initialize
/run/printProgress 100
/gun/particle e-
/gun/energy 20 GeV
/gun/position 0. 0. 0. m
/gun/direction 0.9784010 0.0119860 0.2063682
/run/beamOn 1000
