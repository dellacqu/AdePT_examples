#Validation macro, 100 GeV e-, 1000 events (see runcards/validation/README.md)
#CPU builds: FTFP_BERT (default) and the matched G4HepEm reference (-DWITH_G4HepEm=ON -DWITH_G4HepEmEM=ON)
#requires -DWITH_GPS=OFF
/random/setSeeds 20261123 1100
#/run/setCut must precede /run/initialize (AdePT issue #745)
/run/setCut 0.01 mm
/run/initialize
/run/printProgress 100
/gun/particle e-
/gun/energy 100 GeV
/gun/position 0. 0. 0. m
#eta 0.2 phi 0.01225 (0.0245/2)
/gun/direction 0.980254 0.0120087 0.197375
/run/beamOn 1000
